# General Settings
ENVIRONMENT=development
# Ký JWT đăng nhập app (xem backend/app/core/security.py) — BẮT BUỘC đổi giá
# trị thật khi deploy (openssl rand -hex 32), giữ nguyên = ai cũng tự ký được
# token giả và đăng nhập được bất kỳ tài khoản nào.
SECRET_KEY=your-super-secret-key-32-chars

# Secret NỘI BỘ giữa backend <-> zalo-bridge (2 service Docker nội bộ, không
# liên quan gì tới trình duyệt/frontend nữa — auth người dùng đã chuyển sang
# JWT thật, xem SEED_ADMIN_EMAIL bên dưới). BẮT BUỘC phải đặt.
# Generate: openssl rand -hex 32
API_KEY=change-me-generate-a-random-value

# Tài khoản Admin đầu tiên — backend TỰ TẠO lúc khởi động nếu 2 biến này được
# set và chưa có user nào dùng email đó (idempotent). Không có form tự đăng
# ký công khai, đây là cách DUY NHẤT có tài khoản đầu tiên để đăng nhập.
# Sau khi đã đăng nhập được và tạo thêm Admin khác (nếu cần), có thể xoá 2
# dòng này khỏi .env cho gọn — không ảnh hưởng tài khoản đã tạo.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# Khoá mã hoá config nhạy cảm Admin nhập qua UI (AI provider key — xem
# backend/app/core/crypto.py, backend/app/core/dynamic_config.py).
# BẮT BUỘC đổi giá trị thật khi deploy — mất/đổi khoá này thì mọi config đã
# lưu qua UI không giải mã lại được nữa (phải Admin nhập lại từ đầu).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# Domain frontend thật được phép gọi API khi ENVIRONMENT=production (CORS).
# Bỏ trống = production sẽ chặn hết (an toàn nhưng vỡ luồng) — PHẢI set khi deploy.
# Vd: https://viet-tour-agent-zalo.ts.dev.matbao.ai
ALLOWED_ORIGIN=

# Giới hạn dung lượng file upload (MB) — chặn DoS bằng file khổng lồ.
MAX_UPLOAD_SIZE_MB=20

# Database (MySQL 8.0)
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=tourguide_db
MYSQL_USER=tourguide
MYSQL_PASSWORD=tourguide_pass
DATABASE_URL=mysql+aiomysql://tourguide:tourguide_pass@mysql:3306/tourguide_db?charset=utf8mb4

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# ⚠️ CÁC BIẾN AI PROVIDER DƯỚI ĐÂY GIỜ CHỈ LÀ FALLBACK — cách chính để cấu
# hình/đổi key là UI Admin (Cài đặt hệ thống → Nhà cung cấp AI), áp dụng
# ngay không cần restart, và ưu tiên hơn các biến .env này (xem
# backend/app/core/dynamic_config.py). Giữ các biến này chỉ để deploy lần
# đầu có sẵn AI chạy được trước khi Admin đăng nhập cấu hình qua UI.

# AI Provider — Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider — Azure OpenAI (dùng thay Gemini, hoặc song song để failover).
# Nếu cả GEMINI_API_KEY lẫn bộ AZURE_OPENAI_* dưới đây đều được điền THẬT cùng
# lúc, hệ thống tự log cảnh báo (xem app/core/llm.py) + hiện banner ở frontend,
# và tự động dùng LLM_PRIMARY_PROVIDER trước, fallback provider còn lại nếu lỗi.
# AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# AZURE_OPENAI_MODEL=your_model_name
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Provider thử trước khi có ≥2 provider cùng cấu hình: gemini | azure_openai
LLM_PRIMARY_PROVIDER=gemini

# Zalo Integration
# Phase 1: Zalo Personal Client (unofficial, qua zca-js — chạy trong service
# Node.js riêng "zalo_bridge", backend Python gọi qua HTTP nội bộ). Đăng nhập
# bằng quét QR ngay trong app, không cần app id/secret ở đây.
# ⚠️ Dùng API không chính thức — có rủi ro vi phạm ToS Zalo / khoá tài khoản cá
# nhân. Chưa hỗ trợ tự đăng nhập lại sau khi restart — cần quét QR lại mỗi lần
# (xem ghi chú giới hạn trong zalo-bridge/src/zaloClient.js).
ZALO_BRIDGE_URL=http://zalo_bridge:4000

# Phase 2 (chưa dùng ở MVP): Zalo OA chính thức
# ZALO_APP_ID=your_zalo_app_id
# ZALO_SECRET_KEY=your_zalo_secret_key
# ZALO_OA_ACCESS_TOKEN=your_zalo_oa_token

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend gọi backend từ TRÌNH DUYỆT của HDV (không phải từ trong Docker
# network) — phải là URL truy cập được từ máy HDV, không dùng tên service nội
# bộ (vd "backend"). Next.js inline biến này lúc build (xem frontend/Dockerfile).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ngược lại — frontend gọi backend từ BÊN TRONG Docker network lúc render
# server-side (generateMetadata cho Open Graph ở trang /t/<id>, xem
# frontend/src/lib/server-api.ts). Mặc định "http://backend:8000" (tên
# service trong docker-compose.yml) đã đúng cho hầu hết trường hợp — chỉ cần
# đổi nếu chạy backend ở nơi khác ngoài compose.
# API_INTERNAL_URL=http://backend:8000
